PORT=8787
# Optional. Leave blank — chat works without a key.
# OPENROUTER_API_KEY=

# Optional. Add SMTP settings to deliver verification codes by email.
# Without SMTP, local development shows a temporary verification code in the app.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM=noreply@example.com
